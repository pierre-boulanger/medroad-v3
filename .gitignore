# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
.venv/
venv/
env/

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/

# Secrets — never commit real credentials
.env
*.pem
*.key

# Trained model artefacts (large binaries; distribute via releases)
models_saved/
*.pt
*.ubj
*.pkl
