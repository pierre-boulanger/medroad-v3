# MedROAD V3 — Environment configuration
# Copy to .env and fill in your values

# ── OpenEMR ──────────────────────────────────────────────────────────────────
OPENEMR_BASE_URL=http://localhost:8300
OPENEMR_CLIENT_ID=your-openemr-oauth2-client-id
OPENEMR_CLIENT_SECRET=your-openemr-oauth2-client-secret
OPENEMR_USERNAME=admin
OPENEMR_PASSWORD=Admin1234!

# ── Webhook ───────────────────────────────────────────────────────────────────
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8001
WEBHOOK_URL=http://your-server-ip:8001/fhir/webhook
WEBHOOK_SECRET=change-me-in-production

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP=localhost:9092

# ── Models ────────────────────────────────────────────────────────────────────
MODEL_DIR=./models_saved
RISK_THRESHOLD=0.72

# ── Anthropic ─────────────────────────────────────────────────────────────────
CLAUDE_TEMPERATURE=0.2
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6
